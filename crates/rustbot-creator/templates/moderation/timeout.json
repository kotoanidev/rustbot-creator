{
  "schema": 1,
  "nodes": {
    "n1": {
      "type": "core.slash_command",
      "props": {
        "name": "timeout",
        "description": "$tpl-timeout-description",
        "options": [
          {
            "name": "target",
            "type": "user",
            "description": "$tpl-opt-target",
            "required": true
          },
          {
            "name": "minutes",
            "type": "number",
            "description": "$tpl-opt-minutes",
            "required": true
          },
          {
            "name": "reason",
            "type": "text",
            "description": "$tpl-opt-reason"
          }
        ]
      }
    },
    "n2": {
      "type": "core.has_permission",
      "props": {
        "user": "user",
        "permission": "moderate_members"
      }
    },
    "n3": {
      "type": "core.timeout",
      "props": {
        "user": "option.target",
        "minutes": "{option.minutes}",
        "reason": "{option.reason}"
      }
    },
    "n4": {
      "type": "core.reply",
      "props": {
        "content": "$tpl-timeout-done"
      }
    },
    "n5": {
      "type": "core.reply",
      "props": {
        "content": "$tpl-failed",
        "private": true
      }
    },
    "n6": {
      "type": "core.reply",
      "props": {
        "content": "$tpl-no-permission",
        "private": true
      }
    }
  },
  "edges": [
    {
      "from": "n1.then",
      "to": "n2.run"
    },
    {
      "from": "n2.yes",
      "to": "n3.run"
    },
    {
      "from": "n3.then",
      "to": "n4.run"
    },
    {
      "from": "n3.error",
      "to": "n5.run"
    },
    {
      "from": "n2.no",
      "to": "n6.run"
    }
  ]
}
