//! Settings from the environment, or from a `.env` file in the current folder or a
//! folder above it (D-056). Generated by RustBot Creator: do not edit.
/// The setting `key`. An empty value counts as unset.
pub(crate) fn get(key: &str) -> Option<String> {
    if let Ok(value) = std::env::var(key) {
        return Some(value).filter(|value| !value.is_empty());
    }
    let mut dir = std::env::current_dir().ok()?;
    loop {
        if let Ok(text) = std::fs::read_to_string(dir.join(".env")) {
            return text
                .lines()
                .find_map(|line| {
                    let (name, value) = line.trim().split_once('=')?;
                    let value = value.trim().trim_matches('"');
                    (name.trim() == key && !value.is_empty()).then(|| value.to_owned())
                });
        }
        if !dir.pop() {
            return None;
        }
    }
}
