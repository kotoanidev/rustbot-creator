#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::builders::{SlashCommandBuilder, ValidationError};
use djs_rs::model::rest::CreateApplicationCommand;
use djs_rs::prelude::*;
pub(crate) fn definition() -> Result<CreateApplicationCommand, ValidationError> {
    SlashCommandBuilder::new("tools", "Uses every action")
        .option(
            djs_rs::builders::SlashCommandUserOption::new("target", "Who").required(true),
        )
        .option(
            djs_rs::builders::SlashCommandStringOption::new("emoji", "Which")
                .required(false),
        )
        .option(
            djs_rs::builders::SlashCommandStringOption::new("nick", "Name")
                .required(false),
        )
        .default_member_permissions(
            djs_rs::model::permissions::Permissions::MANAGE_NICKNAMES,
        )
        .build()
}
/// An emoji typed in the form: a Unicode one, or a custom one as Discord
/// writes it, `<:name:id>` or `<a:name:id>` (C-025).
fn reaction(text: &str) -> djs_rs::rest::ReactionEmoji<'_> {
    let text = text.trim();
    let custom = text
        .strip_prefix('<')
        .and_then(|inner| inner.strip_suffix('>'))
        .and_then(|inner| {
            let (rest, id) = inner.rsplit_once(':')?;
            let id = id.parse::<u64>().ok().filter(|id| *id != 0)?;
            let name = rest.rsplit(':').next()?;
            Some((name, id))
        });
    match custom {
        Some((name, id)) => {
            djs_rs::rest::ReactionEmoji::Custom {
                name,
                id: djs_rs::model::id::EmojiId::new(id),
            }
        }
        None => djs_rs::rest::ReactionEmoji::Unicode(text),
    }
}
