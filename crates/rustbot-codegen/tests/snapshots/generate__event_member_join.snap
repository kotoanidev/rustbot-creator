//! The `core.member_join` event graph, from `graphs/events/member_join.json`.
//! Generated by RustBot Creator: do not edit, it is overwritten.
#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::prelude::*;
pub(crate) fn register(client: &Client) {
    client
        .on(
            Events::GuildMemberAdd,
            |ctx, event| async move {
                let server_name = match Some(event.guild_id) {
                    Some(id) => ctx.guilds().fetch(id).await?.name.to_string(),
                    None => String::new(),
                };
                let user_mention = djs_rs::formatters::user_mention(event.member.user.id)
                    .to_string();
                let user_name = match event.member.nick.as_deref() {
                    Some(nick) => nick.to_string(),
                    None => event.member.user.display_name().to_string(),
                };
                ctx.messages(djs_rs::model::id::ChannelId::new(123456789012345678u64))
                    .send(
                        djs_rs::model::rest::CreateMessage::default()
                            .content(
                                format!(
                                    "Welcome {} to {}, {}!", user_mention, server_name,
                                    user_name
                                ),
                            )
                            .allowed_mentions({
                                let mut mentions = djs_rs::model::message::AllowedMentions::default();
                                mentions.users.push(event.member.user.id);
                                mentions
                            }),
                    )
                    .await?;
                {
                    let members = ctx
                        .members(
                            Some(event.guild_id)
                                .ok_or("the event did not come from a server")?,
                        );
                    let user = event.member.user.id;
                    members
                        .add_role(
                            user,
                            djs_rs::model::id::RoleId::new(123456789012345678u64),
                            None,
                        )
                        .await?;
                }
                Ok(())
            },
        );
}
