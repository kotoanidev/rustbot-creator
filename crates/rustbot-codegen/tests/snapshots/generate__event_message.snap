//! The `core.message` event graph, from `graphs/events/message.json`.
//! Generated by RustBot Creator: do not edit, it is overwritten.
#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::prelude::*;
pub(crate) fn register(client: &Client) {
    client
        .on(
            Events::MessageCreate,
            |ctx, event| async move {
                if event.author.bot {
                    return Ok(());
                }
                let channel_mention = djs_rs::formatters::channel_mention(
                        event.channel_id,
                    )
                    .to_string();
                let channel_name = ctx
                    .channels()
                    .fetch(event.channel_id)
                    .await?
                    .name()
                    .unwrap_or_default()
                    .to_string();
                let message = event.content.to_string();
                let server_id = event
                    .guild_id
                    .map(|id| id.to_string())
                    .unwrap_or_default();
                let user_mention = djs_rs::formatters::user_mention(event.author.id)
                    .to_string();
                let user_name = match event
                    .member
                    .as_ref()
                    .and_then(|member| member.nick.as_deref())
                {
                    Some(nick) => nick.to_string(),
                    None => event.author.display_name().to_string(),
                };
                if message.to_string().to_lowercase().contains(&"http".to_lowercase()) {
                    ctx.messages(event.channel_id).delete(event.id).await?;
                    let result: Result<(), Box<dyn std::error::Error + Send + Sync>> = async {
                        let members = ctx
                            .members(
                                event
                                    .guild_id
                                    .ok_or("the event did not come from a server")?,
                            );
                        let user = event.author.id;
                        {
                            let minutes = "10"
                                .trim()
                                .parse::<f64>()
                                .ok()
                                .filter(|minutes| *minutes > 0.0 && *minutes <= 40_320.0)
                                .ok_or(
                                    "a timeout is more than 0 and at most 40320 minutes (28 days)",
                                )?;
                            let until = djs_rs::model::util::Timestamp::from_unix_micros(
                                djs_rs::model::util::Timestamp::now().as_unix_micros()
                                    + (minutes * 60_000_000.0) as i64,
                            );
                            members.timeout(user, Some(until), None)
                        }
                            .await?;
                        Ok(())
                    }
                        .await;
                    if let Err(error) = result {
                        eprintln!("WARN message: {error}");
                        ctx.messages(event.channel_id)
                            .send(
                                djs_rs::model::rest::CreateMessage::default()
                                    .content(
                                        format!(
                                            "{}, no links in {}.", user_mention, channel_mention
                                        ),
                                    )
                                    .allowed_mentions({
                                        let mut mentions = djs_rs::model::message::AllowedMentions::default();
                                        mentions.users.push(event.author.id);
                                        mentions
                                    }),
                            )
                            .await?;
                    }
                } else {
                    if event
                        .member
                        .as_ref()
                        .map(|member| &member.roles)
                        .zip(Some(djs_rs::model::id::RoleId::new(123456789012345678u64)))
                        .is_some_and(|(roles, role)| roles.contains(&role))
                    {
                        event
                            .reply(
                                &ctx,
                                djs_rs::model::rest::CreateMessage::default()
                                    .content(
                                        format!(
                                            "Hi {} in {} on {}", user_name, channel_name, server_id
                                        ),
                                    )
                                    .allowed_mentions(
                                        djs_rs::model::message::AllowedMentions::default(),
                                    )
                                    .embed({
                                        let embed = djs_rs::builders::EmbedBuilder::new();
                                        let embed = embed.title("You said");
                                        let value = message.to_string();
                                        let embed = if value.is_empty() {
                                            embed
                                        } else {
                                            embed.description(value)
                                        };
                                        embed.build()?
                                    }),
                            )
                            .await?;
                    }
                }
                Ok(())
            },
        );
}
