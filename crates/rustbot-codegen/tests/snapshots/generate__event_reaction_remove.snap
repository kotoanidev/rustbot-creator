//! The `core.reaction_remove` event graph, from `graphs/events/reaction_remove.json`.
//! Generated by RustBot Creator: do not edit, it is overwritten.
#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::prelude::*;
pub(crate) fn register(client: &Client) {
    client
        .on(
            Events::MessageReactionRemove,
            |ctx, event| async move {
                let emoji = event.emoji.name().unwrap_or_default().to_string();
                let user_name = match None::<&str> {
                    Some(nick) => nick.to_string(),
                    None => {
                        ctx.users()
                            .fetch(event.user_id)
                            .await?
                            .display_name()
                            .to_string()
                    }
                };
                {
                    let members = ctx
                        .members(
                            event.guild_id.ok_or("the event did not come from a server")?,
                        );
                    let user = event.user_id;
                    members
                        .remove_role(
                            user,
                            djs_rs::model::id::RoleId::new(123456789012345678u64),
                            None,
                        )
                        .await?;
                }
                ctx.messages(event.channel_id)
                    .send(
                        djs_rs::model::rest::CreateMessage::default()
                            .content(format!("{} took back {}", user_name, emoji))
                            .allowed_mentions(
                                djs_rs::model::message::AllowedMentions::default(),
                            ),
                    )
                    .await?;
                Ok(())
            },
        );
}
