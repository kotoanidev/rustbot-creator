//! The `core.reaction_add` event graph, from `graphs/events/reaction_add.json`.
//! Generated by RustBot Creator: do not edit, it is overwritten.
#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::prelude::*;
pub(crate) fn register(client: &Client) {
    client
        .on(
            Events::MessageReactionAdd,
            |ctx, event| async move {
                let emoji = event.emoji.name().unwrap_or_default().to_string();
                if emoji.to_string().to_lowercase() == "👍".to_lowercase() {
                    {
                        let members = ctx
                            .members(
                                event
                                    .guild_id
                                    .ok_or("the event did not come from a server")?,
                            );
                        let user = event.user_id;
                        members
                            .add_role(
                                user,
                                djs_rs::model::id::RoleId::new(123456789012345678u64),
                                None,
                            )
                            .await?;
                    }
                }
                Ok(())
            },
        );
}
