//! The `core.message` event graph, from `graphs/events/threads.json`.
//! Generated by RustBot Creator: do not edit, it is overwritten.
#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::prelude::*;
pub(crate) fn register(client: &Client) {
    client
        .on(
            Events::MessageCreate,
            |ctx, event| async move {
                if event.author.bot {
                    return Ok(());
                }
                let user_name = match event
                    .member
                    .as_ref()
                    .and_then(|member| member.nick.as_deref())
                {
                    Some(nick) => nick.to_string(),
                    None => event.author.display_name().to_string(),
                };
                let _ = {
                    let (channel, message) = (event.channel_id, event.id);
                    ctx.messages(channel)
                        .start_thread(
                            message,
                            &djs_rs::model::rest::StartThreadFromMessage::new(
                                format!("Re: {}", user_name),
                            ),
                            None,
                        )
                        .await?
                };
                Ok(())
            },
        );
}
