//! The `core.message` event graph, from `graphs/events/earn.json`.
//! Generated by RustBot Creator: do not edit, it is overwritten.
#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::prelude::*;
pub(crate) fn register(client: &Client) {
    client
        .on(
            Events::MessageCreate,
            |_ctx, event| async move {
                if event.author.bot {
                    return Ok(());
                }
                {
                    crate::memory::change(
                        "balance",
                        &event.author.id.to_string(),
                        0.5f64,
                        100f64,
                    )?;
                }
                {
                    crate::memory::set(
                        "warnings",
                        &format!(
                            "{}:{}", event.guild_id
                            .ok_or("the event did not come from a server") ?, event
                            .author.id
                        ),
                        crate::memory::number(
                            crate::memory::read(
                                    "balance",
                                    &event.author.id.to_string(),
                                    "100",
                                )
                                .to_string()
                                .trim()
                                .parse::<f64>()
                                .ok()
                                .filter(|number| number.is_finite())
                                .ok_or("a value meant to be a number is not one")?,
                        ),
                    )?;
                }
                Ok(())
            },
        );
}
