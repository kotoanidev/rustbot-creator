//! The `core.member_join` event graph, from `graphs/events/verify.json`.
//! Generated by RustBot Creator: do not edit, it is overwritten.
#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::prelude::*;
pub(crate) fn register(client: &Client) {
    client
        .on(
            Events::GuildMemberAdd,
            |ctx, event| async move {
                let user_mention = djs_rs::formatters::user_mention(event.member.user.id)
                    .to_string();
                ctx.messages(djs_rs::model::id::ChannelId::new(123456789012345678u64))
                    .send(
                        djs_rs::model::rest::CreateMessage::default()
                            .content(
                                format!("Welcome {}, press to verify", user_mention),
                            )
                            .allowed_mentions({
                                let mut mentions = djs_rs::model::message::AllowedMentions::default();
                                mentions.users.push(event.member.user.id);
                                mentions
                            })
                            .components([
                                djs_rs::builders::ActionRowBuilder::new()
                                    .component(
                                        djs_rs::builders::ButtonBuilder::success("e.verify.n2:b1")
                                            .label("Verify"),
                                    )
                                    .build()?,
                            ]),
                    )
                    .await?;
                Ok(())
            },
        );
    client
        .component(
            "e.verify.n2",
            |ctx, cmd| async move {
                let interaction = cmd.interaction();
                let replied = std::cell::Cell::new(false);
                let item = cmd.args().split(':').next().unwrap_or_default();
                if item == "b1" {
                    {
                        let members = ctx
                            .members(
                                interaction
                                    .guild_id
                                    .ok_or("the command was not used on a server")?,
                            );
                        let user = interaction
                            .author()
                            .map(|user| user.id)
                            .ok_or("the command has no user")?;
                        members
                            .add_role(
                                user,
                                djs_rs::model::id::RoleId::new(123456789012345678u64),
                                None,
                            )
                            .await?;
                    }
                    if replied.replace(true) {
                        cmd.follow_up(
                                &ctx,
                                djs_rs::model::rest::CreateFollowupMessage::default()
                                    .content("Verified")
                                    .allowed_mentions(
                                        djs_rs::model::message::AllowedMentions::default(),
                                    )
                                    .ephemeral(),
                            )
                            .await?;
                    } else {
                        cmd.reply(
                                &ctx,
                                djs_rs::model::interaction::MessageCallbackData::default()
                                    .content("Verified")
                                    .allowed_mentions(
                                        djs_rs::model::message::AllowedMentions::default(),
                                    )
                                    .ephemeral(),
                            )
                            .await?;
                    }
                }
                if !replied.get() {
                    cmd.defer_update(&ctx).await?;
                }
                Ok(())
            },
        );
}
