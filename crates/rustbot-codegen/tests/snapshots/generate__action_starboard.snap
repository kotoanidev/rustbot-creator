//! The `core.reaction_add` event graph, from `graphs/events/starboard.json`.
//! Generated by RustBot Creator: do not edit, it is overwritten.
#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::prelude::*;
/// An emoji typed in the form: a Unicode one, or a custom one as Discord
/// writes it, `<:name:id>` or `<a:name:id>` (C-025).
fn reaction(text: &str) -> djs_rs::rest::ReactionEmoji<'_> {
    let text = text.trim();
    let custom = text
        .strip_prefix('<')
        .and_then(|inner| inner.strip_suffix('>'))
        .and_then(|inner| {
            let (rest, id) = inner.rsplit_once(':')?;
            let id = id.parse::<u64>().ok().filter(|id| *id != 0)?;
            let name = rest.rsplit(':').next()?;
            Some((name, id))
        });
    match custom {
        Some((name, id)) => {
            djs_rs::rest::ReactionEmoji::Custom {
                name,
                id: djs_rs::model::id::EmojiId::new(id),
            }
        }
        None => djs_rs::rest::ReactionEmoji::Unicode(text),
    }
}
pub(crate) fn register(client: &Client) {
    client
        .on(
            Events::MessageReactionAdd,
            |ctx, event| async move {
                let emoji = event.emoji.name().unwrap_or_default().to_string();
                let user_name = match event
                    .member
                    .as_ref()
                    .and_then(|member| member.nick.as_deref())
                {
                    Some(nick) => nick.to_string(),
                    None => {
                        ctx.users()
                            .fetch(event.user_id)
                            .await?
                            .display_name()
                            .to_string()
                    }
                };
                if emoji.to_string().to_lowercase() == "⭐".to_lowercase() {
                    let result: Result<(), Box<dyn std::error::Error + Send + Sync>> = async {
                        let (channel, message) = (event.channel_id, event.message_id);
                        ctx.messages(channel).pin(message, None).await?;
                        Ok(())
                    }
                        .await;
                    match result {
                        Ok(()) => {
                            let (channel, message) = (
                                event.channel_id,
                                event.message_id,
                            );
                            ctx.messages(channel)
                                .react(message, reaction("<:star:123456789012345678>"))
                                .await?;
                        }
                        Err(error) => {
                            eprintln!("WARN starboard: {error}");
                            ctx.users()
                                .send(
                                    event.user_id,
                                    djs_rs::model::rest::CreateMessage::default()
                                        .content(format!("Pinned, {}", user_name))
                                        .allowed_mentions(
                                            djs_rs::model::message::AllowedMentions::default(),
                                        ),
                                )
                                .await?;
                        }
                    }
                }
                Ok(())
            },
        );
}
