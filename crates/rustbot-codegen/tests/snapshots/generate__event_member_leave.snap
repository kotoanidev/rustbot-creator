//! The `core.member_leave` event graph, from `graphs/events/member_leave.json`.
//! Generated by RustBot Creator: do not edit, it is overwritten.
#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::prelude::*;
pub(crate) fn register(client: &Client) {
    client
        .on(
            Events::GuildMemberRemove,
            |ctx, event| async move {
                let user_id = event.new.user.id.to_string();
                let user_name = match None::<&str> {
                    Some(nick) => nick.to_string(),
                    None => event.new.user.display_name().to_string(),
                };
                let user_username = event.new.user.username.to_string();
                ctx.messages(djs_rs::model::id::ChannelId::new(123456789012345678u64))
                    .send(
                        djs_rs::model::rest::CreateMessage::default()
                            .content(
                                format!(
                                    "Bye {} ({}, {})", user_name, user_username, user_id
                                ),
                            )
                            .allowed_mentions(
                                djs_rs::model::message::AllowedMentions::default(),
                            ),
                    )
                    .await?;
                Ok(())
            },
        );
}
