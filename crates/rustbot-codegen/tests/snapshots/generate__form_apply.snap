                                        mentions.users.push(author.id);
                                        mentions
                                    }),
                            )
                            .await?;
                        if !form_replied.get() {
                            form.defer_update(&ctx).await?;
                        }
                    }
                }
                if !replied.get() {
                    cmd.defer_update(&ctx).await?;
                }
                Ok(())
