    SlashCommandBuilder::new("apply", "Posts the application button").build()
}
pub(crate) fn register(client: &Client) {
    client
        .command(
            "apply",
            |ctx, cmd| async move {
                cmd.reply(
                        &ctx,
                        djs_rs::model::interaction::MessageCallbackData::default()
