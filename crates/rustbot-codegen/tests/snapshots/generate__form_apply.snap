                let author = interaction.author().ok_or("the command has no user")?;
                let replied = std::cell::Cell::new(false);
                let user_mention = djs_rs::formatters::user_mention(author.id);
                let item = cmd.args().split(':').next().unwrap_or_default();
                if item == "b1" {
                    let modal = djs_rs::builders::ModalBuilder::new(
                            "form:n3",
                            "Application",
                        )
                        .label(
                            "About you",
                            djs_rs::builders::TextInputBuilder::paragraph("about")
                                .required(false),
                        )
                        .build()?;
                    cmd.show_modal(&ctx, modal).await?;
                    replied.set(true);
                    let sent = cmd
                        .await_modal_submit(&ctx, std::time::Duration::from_secs(900))
                        .filter(|submitted| submitted.custom_id == "form:n3")
                        .await;
                    if let Ok(form) = sent {
                        let form_replied = std::cell::Cell::new(false);
                        let field_about = form
                            .text_value("about")
                            .unwrap_or_default()
                            .to_owned();
                        ctx.messages(
