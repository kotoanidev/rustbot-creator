//! The `core.message` event graph, from `graphs/events/ask_delete.json`.
//! Generated by RustBot Creator: do not edit, it is overwritten.
#![allow(clippy::collapsible_if, clippy::collapsible_else_if)]
use djs_rs::prelude::*;
pub(crate) fn register(client: &Client) {
    client
        .on(
            Events::MessageCreate,
            |ctx, event| async move {
                if event.author.bot {
                    return Ok(());
                }
                let message = event.content.to_string();
                {
                    let sent = event
                        .reply(
                            &ctx,
                            djs_rs::model::rest::CreateMessage::default()
                                .content(format!("Delete {}?", message))
                                .allowed_mentions(
                                    djs_rs::model::message::AllowedMentions::default(),
                                )
                                .components([
                                    djs_rs::builders::ActionRowBuilder::new()
                                        .component(
                                            djs_rs::builders::ButtonBuilder::danger("wait:b1")
                                                .label("Delete"),
                                        )
                                        .build()?,
                                ]),
                        )
                        .await?;
                    let mut clicks = sent
                        .component_collector(&ctx)
                        .time(
                            std::time::Duration::from_secs_f64(
                                message
                                    .to_string()
                                    .trim()
                                    .parse::<f64>()
                                    .ok()
                                    .filter(|value| *value > 0.0 && *value <= 1440f64)
                                    .ok_or(
                                        "a wait is more than 0 and at most 1440 units of 60 seconds",
                                    )? * 60f64,
                            ),
                        )
                        .build();
                    let allowed = event.author.id;
                    let mut click = None;
                    while let Some(next) = clicks.next().await {
                        if next.interaction().author().map(|user| user.id)
                            != Some(allowed)
                        {
                            next.defer_update(&ctx).await?;
                            continue;
                        }
                        click = Some(next);
                        break;
                    }
                    let _ = ctx
                        .messages(sent.channel_id)
                        .edit(
                            sent.id,
                            &djs_rs::model::rest::EditMessage::default().components([]),
                        )
                        .await;
                    if let Some(click) = click {
                        let click_replied = std::cell::Cell::new(false);
                        let item = click
                            .custom_id
                            .strip_prefix("wait:")
                            .unwrap_or_default();
                        if item == "b1" {
                            ctx.messages(event.channel_id).delete(event.id).await?;
                            if click_replied.replace(true) {
                                click
                                    .follow_up(
                                        &ctx,
                                        djs_rs::model::rest::CreateFollowupMessage::default()
                                            .content("Deleted")
                                            .allowed_mentions(
                                                djs_rs::model::message::AllowedMentions::default(),
                                            )
                                            .ephemeral(),
                                    )
                                    .await?;
                            } else {
                                click
                                    .reply(
                                        &ctx,
                                        djs_rs::model::interaction::MessageCallbackData::default()
                                            .content("Deleted")
                                            .allowed_mentions(
                                                djs_rs::model::message::AllowedMentions::default(),
                                            )
                                            .ephemeral(),
                                    )
                                    .await?;
                            }
                        }
                        if !click_replied.get() {
                            click.defer_update(&ctx).await?;
                        }
                    }
                }
                Ok(())
            },
        );
}
